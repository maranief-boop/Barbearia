# ============================================================
# BARBEIRARIA — Variáveis de ambiente (White-Label)
# Copie este arquivo para .env e preencha com seus valores.
# ============================================================

# ---------- Supabase (obrigatório) ----------
# Dashboard do seu projeto > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Identidade da marca (opcional — tem fallbacks) ----------
VITE_BRAND_NAME=Barbearia Navalha de Ouro
VITE_BRAND_TAGLINE=Estilo clássico, acabamento moderno.
VITE_BRAND_LOGO_URL=

# Cores da marca (hex). Usadas em todo o site, PWA e painel.
VITE_BRAND_PRIMARY=#f59e0b
VITE_BRAND_SECONDARY=#1c1917
VITE_BRAND_DARK=#0c0a09
VITE_BRAND_LIGHT=#fafaf9

# ---------- Contato / WhatsApp ----------
# Número no formato internacional, apenas dígitos (ex.: 5511999999999)
VITE_BRAND_WHATSAPP=5511999999999
VITE_BRAND_WHATSAPP_MESSAGE=Olá! Quero agendar um horário.

# ---------- Endereço / Localização ----------
VITE_BRAND_ADDRESS=Rua das Tesouras, 123 - Centro
VITE_BRAND_CITY=São Paulo - SP
# URL de embed do Google Maps (iframe src), opcional
VITE_BRAND_MAPS_EMBED=

# ---------- Redes sociais / E-mail ----------
VITE_BRAND_INSTAGRAM=
VITE_BRAND_FACEBOOK=
VITE_BRAND_EMAIL=

# Galeria de fotos do site (URLs separadas por vírgula)
VITE_BRAND_GALLERY=/gallery/g1.svg,/gallery/g2.svg,/gallery/g3.svg,/gallery/g4.svg
